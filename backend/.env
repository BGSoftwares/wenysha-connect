# Django / MySQL / JWT / CORS config
DJANGO_SECRET_KEY=development-secret-key-change-in-production-use-env-2026-abcdefghi123456
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# MySQL connection used by Django
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=able_god_college
MYSQL_USER=root
MYSQL_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8081

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Admin user to create by seed script
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@ablegodcollege.edu
SEED_ADMIN_PASSWORD=adminpass

# Database Choice
USE_SQLITE=True
