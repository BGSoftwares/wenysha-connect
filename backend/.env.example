# Django / MySQL / JWT / CORS config example
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SECURE_SSL_REDIRECT=False
USE_SQLITE=False

# MySQL connection used by Django
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=able_god_college
MYSQL_USER=able_god_college_user
MYSQL_PASSWORD=secretpassword

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Admin user to create by seed script (optional) — values provided
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=bgurumanischoolstuff@gmail.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-random-password

# EcoCash Online Payments. Credentials and merchant details are issued after
# merchant/developer onboarding. Keep real values in backend/.env or a secret store.
ECOCASH_PAYMENT_URL=
ECOCASH_USERNAME=
ECOCASH_PASSWORD=
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_PIN=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_TERMINAL_ID=
ECOCASH_LOCATION=Harare
ECOCASH_MERCHANT_NAME=
ECOCASH_SUPER_MERCHANT_NAME=ECOCASH
ECOCASH_SUPPORTED_CURRENCIES=USD

# ZimSwitch COPYandPAY. Use the UAT host/keys first; obtain merchant keys from
# the acquiring bank/ZimSwitch before enabling live payments.
ZIMSWITCH_BASE_URL=
ZIMSWITCH_ENTITY_ID=
ZIMSWITCH_ACCESS_TOKEN=
ZIMSWITCH_SUPPORTED_CURRENCIES=USD,ZWG
ZIMSWITCH_WIDGET_BRANDS=VISA MASTER PRIVATE_LABEL
