# Copy to deploy.env, replace every placeholder, and keep the real file private.
DOMAIN=school.example.org
TLS_CERT_DIR=/opt/ablegod/certs

DJANGO_SECRET_KEY=replace-with-a-unique-secret-at-least-50-characters-long
DJANGO_DEFAULT_FROM_EMAIL=webmaster@school.example.org

MYSQL_HOST=192.0.2.10
MYSQL_PORT=3306
MYSQL_DATABASE=able_god_college
MYSQL_USER=able_god_college_user
MYSQL_PASSWORD=replace-with-a-strong-database-password

# Shared cache for login rate limits, lockouts and MFA. Use letters and digits only
# (it is embedded in a URL). Required: without it limits do not work across replicas.
REDIS_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Number of backend replicas the load balancer spreads traffic across.
BACKEND_REPLICAS=2

# Optional: separate key for encrypting authenticator-app secrets. Leave empty to
# derive it from DJANGO_SECRET_KEY (then rotating that key resets everyone's MFA).
MFA_ENCRYPTION_KEY=

# Optional frontend configuration for Supabase-backed AI features.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Add payment gateway secrets here only when those payment methods are enabled.

# Per-IP sign-up / admission application limit (optional).
# SIGNUP_THROTTLE_RATE=10/hour

# Roles that must use two-step verification (comma separated, empty = nobody).
MFA_REQUIRED_ROLES=Admin
