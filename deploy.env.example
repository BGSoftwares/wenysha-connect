# Copy to deploy.env, replace every placeholder, and keep the real file private.
DOMAIN=school.example.org
TLS_CERT_DIR=/opt/ablegod/certs

DJANGO_SECRET_KEY=replace-with-a-unique-secret-at-least-50-characters-long
DJANGO_DEFAULT_FROM_EMAIL=webmaster@school.example.org

MYSQL_HOST=192.0.2.10
MYSQL_PORT=3306
MYSQL_DATABASE=able_god_college
MYSQL_USER=able_god_college_user
MYSQL_PASSWORD=replace-with-a-strong-database-password

# Shared cache for login rate limits, lockouts and MFA. Use letters and digits only
# (it is embedded in a URL). Required: without it limits do not work across replicas.
REDIS_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Number of backend replicas the load balancer spreads traffic across.
BACKEND_REPLICAS=2

# Optional: separate key for encrypting authenticator-app secrets. Leave empty to
# derive it from DJANGO_SECRET_KEY (then rotating that key resets everyone's MFA).
MFA_ENCRYPTION_KEY=

# Optional frontend configuration for Supabase-backed AI features.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Add payment gateway secrets here only when those payment methods are enabled.

# Per-IP sign-up / admission application limit (optional).
# SIGNUP_THROTTLE_RATE=10/hour

# Roles that must use two-step verification. Production always requires these staff roles;
# add more roles here if needed. Accounts can use an authenticator app or email verification.
MFA_REQUIRED_ROLES=Admin,Accounts,Teacher

# Daily backup (database + uploaded files). Time is UTC.
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# Required off-server copy. BACKUP_REMOTE is "<name>:<bucket-or-folder>", and the name is
# configured below with RCLONE_CONFIG_<NAME>_* lines. Example for an S3-compatible bucket (name = OFFSITE):
#   BACKUP_REMOTE=offsite:my-school-backups/portal
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Other        # AWS, Cloudflare, Wasabi, Backblaze (S3), DigitalOcean, Other ...
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
# Other types work the same way (sftp, b2, drive, dropbox, onedrive ...): see https://rclone.org/docs/
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30

# Encrypts every backup file (AES-256) before it is stored or uploaded. LOSE THIS AND THE BACKUPS CANNOT BE OPENED.
# Required in production. Keep a copy in a password manager.
BACKUP_ENCRYPTION_PASSPHRASE=

# ---- Online fee payments --------------------------------------------------------------------------
# Leave a provider's lines empty to keep it switched off. Real values come from the school's EcoCash
# merchant onboarding and from the acquiring bank / ZimSwitch. Never put these in chat or in git.
ECOCASH_PAYMENT_URL=
ECOCASH_USERNAME=
ECOCASH_PASSWORD=
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_PIN=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_TERMINAL_ID=
ECOCASH_LOCATION=Harare
ECOCASH_MERCHANT_NAME=
ECOCASH_SUPER_MERCHANT_NAME=ECOCASH
ECOCASH_SUPPORTED_CURRENCIES=USD
ZIMSWITCH_BASE_URL=
ZIMSWITCH_ENTITY_ID=
ZIMSWITCH_ACCESS_TOKEN=
ZIMSWITCH_SUPPORTED_CURRENCIES=USD,ZWG
ZIMSWITCH_WIDGET_BRANDS=VISA MASTER PRIVATE_LABEL
# Paynow (paynow.co.zw): create an integration in your Paynow merchant account and copy its ID and key.
# The currencies must match what that integration is set up to accept. In Paynow's test mode, PAYNOW_AUTH_EMAIL
# must be the merchant account's own email; in live mode leave it empty so the payer's email is used.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_SUPPORTED_CURRENCIES=USD
PAYNOW_AUTH_EMAIL=
# Optional: the public address Paynow posts results to. Default is https://<your domain>/api/finance/paynow/result/
PAYNOW_RESULT_URL=
# Shown to parents for direct deposits. Parents are told to use the invoice number as the reference.
SCHOOL_BANK_ACCOUNT_NAME=ABLE GOD COLLEGE
SCHOOL_BANK_ACCOUNT_NUMBER=3252015253451
SCHOOL_BANK_NAME=NBS
SCHOOL_BANK_BRANCH=MASVINGO
# Optional: lets the bank push credits to /api/finance/bank-deposits/webhook/ (HMAC-SHA256 of the body in
# the X-Bank-Signature header). 16+ random characters. Empty = webhook off; statement CSV import still works.
BANK_WEBHOOK_SECRET=
# Gateway payments still unconfirmed after this many hours are cancelled so they stop blocking the invoice.
PENDING_EXPIRY_HOURS=24
